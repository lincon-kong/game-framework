# Use a different project name and host port for each local game/environment.
COMPOSE_PROJECT_NAME=mygame-local
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mygame
PGUSER=mygame
# Set a private password before starting Compose. Single-quote values containing $.
PGPASSWORD=
# Local Compose has no TLS. Remote databases should use verify-full and PGSSLROOTCERT.
PGSSLMODE=disable
PGCONNECT_TIMEOUT=5
