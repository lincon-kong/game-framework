{
  "server": {
    "enabled": true,
    "modulePath": "server"
  },
  "luban": {
    "enabled": true,
    "config": "data/luban.conf",
    "target": "all",
    "languages": ["typescript", "go"],
    "outputRoot": "data/generated"
  },
  "protobuf": {
    "enabled": false,
    "source": "shared/protocol",
    "typescriptOut": "client/generated/protocol",
    "goOut": "server/generated/protocol"
  }
}
